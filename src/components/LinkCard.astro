---
import { ChevronRight } from 'lucide-astro';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  isExternal?: boolean;
}

const { href, title, subtitle, isExternal = false } = Astro.props;
---

<a 
  href={href}
  target={isExternal ? "_blank" : "_self"}
  rel={isExternal ? "noopener noreferrer" : ""}
  class="link-card group relative overflow-hidden block bg-zinc-900/90 border border-zinc-800 rounded-2xl p-5 shadow-lg transition-all duration-200"
>
  <span class="liquid-fill"></span>
  <div class="flex items-center justify-between relative z-10">
    <div class="flex flex-col gap-1">
      <h3 class="text-xl font-semibold text-zinc-100 group-hover:text-amber-500 transition-colors">
        {title}
      </h3>
      {subtitle && (
        <span class="text-sm text-zinc-400">
          {subtitle}
        </span>
      )}
    </div>
    
    <div class="text-zinc-500 group-hover:text-amber-500 transition-colors">
      <ChevronRight size={24} />
    </div>
  </div>
</a>
