---
interface Props {
  name: string;
  price: string;
  description?: string;
  allergens?: string[];
}

const { name, price, description, allergens } = Astro.props;
---

<div class="product-item p-4 bg-zinc-900/80 border-b border-zinc-800/50 last:border-b-0 backdrop-blur-sm" data-price={price}>
  <div class="flex justify-between items-start gap-4">
    <div class="flex-1">
      <h4 class="text-lg font-bold text-zinc-100">{name}</h4>
      {description && (
        <p class="text-sm text-zinc-400 mt-1 leading-relaxed">{description}</p>
      )}
      
      {allergens && allergens.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-2">
          {allergens.map((allergen) => (
            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700">
              {allergen}
            </span>
          ))}
        </div>
      )}
    </div>
    <div class="price-display text-lg font-bold text-amber-500 whitespace-nowrap">
      {price}
    </div>
  </div>
</div>
