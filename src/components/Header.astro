---
import { ChevronLeft } from 'lucide-astro';

interface Props {
  backUrl?: string;
  showLogo?: boolean;
}

const { backUrl, showLogo = true } = Astro.props;
---

<header class="relative flex items-center justify-center p-4 min-h-[80px]">
  {backUrl && (
    <a 
      href={backUrl} 
      class="absolute left-4 p-2 text-zinc-300 hover:text-white bg-black/50 rounded-full backdrop-blur-md transition-colors active:scale-95"
      aria-label="Volver"
    >
      <ChevronLeft size={28} />
    </a>
  )}
  
  {showLogo && (
    <div class="flex items-center justify-center">
      <!-- Using the provided logo -->
      <img 
        src="/img/logo.webp" 
        alt="Arenal El Chiringuito" 
        class="h-80 w-auto drop-shadow-xl"
        fetchpriority="high"
      />
    </div>
  )}
</header>
