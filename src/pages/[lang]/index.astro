---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import LinkCard from "../../components/LinkCard.astro";
import { Instagram, Facebook, Star, ChevronRight } from "lucide-astro";
import { getStaticLangPaths, t, type Lang } from "../../i18n/translations";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params as { lang: Lang };
const i = t(lang);
---

<Layout title={i.welcome} lang={lang}>
  <Header showLogo={true} />

  <main class="flex-1 flex flex-col px-4 pb-6">
    <div class="mb-6 text-center">
      <h1 class="text-3xl font-extrabold text-white tracking-tight mb-2">
        {i.welcome}
      </h1>
      <p class="text-zinc-400 text-sm">{i.discoverMenu}</p>
    </div>

    <!-- Cozy terrace night card with zoom-hover effect -->
    <div class="terrace-card">
      <div class="terrace-glow" style="background-image: url('/img/terraza-noche.jpg');"></div>
      <div class="terrace-image-wrapper">
        <img 
          src="/img/terraza-noche.jpg" 
          alt="Terraza Arenal El Chiringuito" 
          class="terrace-image"
        />
      </div>
      <div class="terrace-overlay"></div>
    </div>

    <div class="space-y-4">
      <LinkCard
        href={`/${lang}/carta`}
        title={i.viewMenu}
        subtitle={i.viewMenuSub}
      />
      <LinkCard
        href={`/${lang}/ubicacion`}
        title={i.locationCardTitle}
        subtitle={i.locationCardSub}
      />
      <a
        href="https://www.google.com/maps/place/Chiringuito+El+Arenal/@38.179374,-1.374019,17z/data=!4m8!3m7!1s0xd646f933d1deb1f:0xac5e8b4fe891f456!8m2!3d38.179374!4d-1.374019!9m1!1b1!16s%2Fg%2F11y1q94b46"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex items-center justify-between p-5 bg-zinc-900/90 border border-zinc-800 rounded-2xl shadow-lg active:scale-[0.97] active:bg-zinc-800/90 transition-all duration-150 overflow-hidden"
      >
        <div class="absolute right-0 top-0 w-32 h-32 bg-amber-500/10 rounded-full blur-3xl -mr-10 -mt-10 transition-transform group-hover:scale-150"></div>
        <div class="relative flex items-center gap-4">
          <div class="flex items-center justify-center w-12 h-12 bg-zinc-800 rounded-full shadow-inner flex-shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-xl font-semibold text-zinc-100 group-hover:text-amber-500 transition-colors">
              {i.reviewsTitle}
            </h3>
            <div class="flex items-center gap-1">
              <span class="text-sm font-medium text-zinc-300 mr-1">5.0</span>
              <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
              <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
              <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
              <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
              <Star class="w-3.5 h-3.5 fill-amber-500 text-amber-500" />
            </div>
          </div>
        </div>
        <div class="relative text-zinc-500 group-hover:text-amber-500 transition-colors">
          <ChevronRight size={24} />
        </div>
      </a>
    </div>

    <div class="mt-auto pt-12 pb-6">
      <div class="flex justify-center gap-6">
        <a
          href="https://www.instagram.com/arenal_elchiringuito/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-zinc-900 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all shadow-lg active:scale-95"
          aria-label="Instagram"
        >
          <Instagram size={24} />
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61584602348346"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-zinc-900 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all shadow-lg active:scale-95"
          aria-label="Facebook"
        >
          <Facebook size={24} />
        </a>
      </div>
      <p class="text-center text-zinc-300 text-xs mt-6">
        &copy; {new Date().getFullYear()} Arenal El Chiringuito
      </p>
      <p class="text-center text-zinc-300 text-xs mt-2">
        {i.developedBy}
      </p>
      <p class="text-center text-zinc-500 text-xs mt-4">
        <a
          href={`/${lang}/legal`}
          class="hover:text-zinc-300 underline transition-colors"
          >{i.legalNotice}
        </a>
      </p>
    </div>
  </main>
</Layout>

<style>
  .terrace-card {
    position: relative;
    width: 100%;
    height: 200px;
    margin-bottom: 2rem;
    border-radius: 1.75rem;
    overflow: visible; /* to allow glow to show outside */
    border: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
  }

  .terrace-glow {
    position: absolute;
    inset: -6px;
    background-size: cover;
    background-position: center;
    filter: blur(16px);
    opacity: 0.25;
    border-radius: 2rem;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.5s ease;
  }

  .terrace-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.75rem;
    position: relative;
    z-index: 10;
  }

  .terrace-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .terrace-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.3) 100%
    );
    z-index: 20;
    border-radius: 1.75rem;
  }

  /* Micro-interactions & Zoom Effect */
  .terrace-card:hover .terrace-image,
  .terrace-card:active .terrace-image {
    transform: scale(1.08);
  }

  .terrace-card:hover .terrace-glow {
    opacity: 0.4;
  }
</style>
