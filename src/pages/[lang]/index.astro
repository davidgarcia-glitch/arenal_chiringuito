---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import LinkCard from "../../components/LinkCard.astro";
import { Instagram, Facebook } from "lucide-astro";
import { getStaticLangPaths, t, type Lang } from "../../i18n/translations";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params as { lang: Lang };
const i = t(lang);
---

<Layout title={i.welcome} lang={lang}>
  <div class="hero-container">
    <!-- Blur background glow for depth -->
    <div class="hero-glow" style="background-image: url('/img/terraza-noche.jpg');"></div>
    
    <!-- Animated image -->
    <img 
      src="/img/terraza-noche.jpg" 
      alt="Terraza Arenal El Chiringuito" 
      class="hero-image ken-burns"
    />
    
    <!-- Smooth cinematic gradient mask -->
    <div class="hero-overlay"></div>
    
    <!-- Centered Glassmorphic Logo -->
    <div class="hero-logo-container">
      <div class="glass-logo-wrapper">
        <img 
          src="/img/logo.png" 
          alt="Arenal El Chiringuito" 
          class="h-24 w-auto drop-shadow-xl"
        />
      </div>
    </div>
  </div>

  <main class="flex-1 flex flex-col px-4 py-6">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-extrabold text-white tracking-tight mb-2">
        {i.welcome}
      </h1>
      <p class="text-zinc-400">{i.discoverMenu}</p>
    </div>

    <div class="space-y-4">
      <LinkCard
        href={`/${lang}/carta`}
        title={i.viewMenu}
        subtitle={i.viewMenuSub}
      />
      <LinkCard
        href={`/${lang}/ubicacion`}
        title={i.locationCardTitle}
        subtitle={i.locationCardSub}
      />
    </div>

    <div class="mt-auto pt-12 pb-6">
      <div class="flex justify-center gap-6">
        <a
          href="https://www.instagram.com/arenal_elchiringuito/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-zinc-900 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all shadow-lg active:scale-95"
          aria-label="Instagram"
        >
          <Instagram size={24} />
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61584602348346"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-zinc-900 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all shadow-lg active:scale-95"
          aria-label="Facebook"
        >
          <Facebook size={24} />
        </a>
      </div>
      <p class="text-center text-zinc-300 text-xs mt-6">
        &copy; {new Date().getFullYear()} Arenal El Chiringuito
      </p>
      <p class="text-center text-zinc-300 text-xs mt-2">
        {i.developedBy}
      </p>
      <p class="text-center text-zinc-500 text-xs mt-4">
        <a
          href={`/${lang}/legal`}
          class="hover:text-zinc-300 underline transition-colors"
          >{i.legalNotice}
        </a>
      </p>
    </div>
  </main>
</Layout>

<style>
  .hero-container {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
    border-bottom-left-radius: 2.5rem;
    border-bottom-right-radius: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-glow {
    position: absolute;
    inset: -10px;
    background-size: cover;
    background-position: center;
    filter: blur(20px);
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    position: relative;
    z-index: 10;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 19, 17, 0.1) 0%,
      rgba(26, 19, 17, 0.45) 50%,
      #1a1311 100%
    );
    z-index: 20;
  }

  .hero-logo-container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 30;
    padding-top: 1.5rem;
  }

  .glass-logo-wrapper {
    background: rgba(26, 19, 17, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.25rem 2rem;
    border-radius: 2.25rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
    transform: translateY(0);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-logo-wrapper:hover {
    transform: translateY(-4px) scale(1.02);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7);
  }

  /* Cinematic Ken Burns zoom effect */
  .ken-burns {
    animation: kenburns 15s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate;
  }

  @keyframes kenburns {
    0% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1.12);
    }
  }
</style>
