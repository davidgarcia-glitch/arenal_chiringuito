---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import LinkCard from "../../components/LinkCard.astro";
import { Instagram, Facebook } from "lucide-astro";
import { getStaticLangPaths, t, type Lang } from "../../i18n/translations";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params as { lang: Lang };
const i = t(lang);
---

<Layout title={i.welcome} lang={lang}>
  <Header showLogo={true} />

  <main class="flex-1 flex flex-col px-4 pb-6">
    <div class="mb-6 text-center">
      <h1 class="text-3xl font-extrabold text-white tracking-tight mb-2">
        {i.welcome}
      </h1>
      <p class="text-zinc-400 text-sm">{i.discoverMenu}</p>
    </div>

    <!-- Cozy terrace night card with zoom-hover effect -->
    <div class="terrace-card">
      <div class="terrace-glow" style="background-image: url('/img/terraza-noche.jpg');"></div>
      <div class="terrace-image-wrapper">
        <img 
          src="/img/terraza-noche.jpg" 
          alt="Terraza Arenal El Chiringuito" 
          class="terrace-image"
        />
      </div>
      <div class="terrace-overlay"></div>
      <div class="terrace-text">
        <span class="terrace-tag">Establecimiento</span>
        <h3 class="terrace-title">Nuestra Terraza</h3>
      </div>
    </div>

    <div class="space-y-4">
      <LinkCard
        href={`/${lang}/carta`}
        title={i.viewMenu}
        subtitle={i.viewMenuSub}
      />
      <LinkCard
        href={`/${lang}/ubicacion`}
        title={i.locationCardTitle}
        subtitle={i.locationCardSub}
      />
    </div>

    <div class="mt-auto pt-12 pb-6">
      <div class="flex justify-center gap-6">
        <a
          href="https://www.instagram.com/arenal_elchiringuito/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-zinc-900 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all shadow-lg active:scale-95"
          aria-label="Instagram"
        >
          <Instagram size={24} />
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61584602348346"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 bg-zinc-900 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all shadow-lg active:scale-95"
          aria-label="Facebook"
        >
          <Facebook size={24} />
        </a>
      </div>
      <p class="text-center text-zinc-300 text-xs mt-6">
        &copy; {new Date().getFullYear()} Arenal El Chiringuito
      </p>
      <p class="text-center text-zinc-300 text-xs mt-2">
        {i.developedBy}
      </p>
      <p class="text-center text-zinc-500 text-xs mt-4">
        <a
          href={`/${lang}/legal`}
          class="hover:text-zinc-300 underline transition-colors"
          >{i.legalNotice}
        </a>
      </p>
    </div>
  </main>
</Layout>

<style>
  .terrace-card {
    position: relative;
    width: 100%;
    height: 200px;
    margin-bottom: 2rem;
    border-radius: 1.75rem;
    overflow: visible; /* to allow glow to show outside */
    border: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
  }

  .terrace-glow {
    position: absolute;
    inset: -6px;
    background-size: cover;
    background-position: center;
    filter: blur(16px);
    opacity: 0.25;
    border-radius: 2rem;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.5s ease;
  }

  .terrace-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.75rem;
    position: relative;
    z-index: 10;
  }

  .terrace-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .terrace-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0.85) 100%
    );
    z-index: 20;
    border-radius: 1.75rem;
  }

  .terrace-text {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 30;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .terrace-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #f59e0b; /* amber-500 */
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .terrace-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  /* Micro-interactions & Zoom Effect */
  .terrace-card:hover .terrace-image,
  .terrace-card:active .terrace-image {
    transform: scale(1.08);
  }

  .terrace-card:hover .terrace-glow {
    opacity: 0.4;
  }
</style>
