---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import type { Lang } from "../i18n/translations";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	lang?: Lang;
}

const { title, lang = "es" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Arenal El Chiringuito - Menú Digital"
		/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
		/>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Arenal El Chiringuito</title>

		<!-- Google Fonts: Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-[#1a1311] text-zinc-100 antialiased min-h-screen relative font-sans"
	>
		<!-- Wood texture background overlay -->
		<div
			transition:persist
			class="fixed inset-0 z-0 pointer-events-none opacity-50 bg-cover bg-center"
			style="background-image: url('/img/fondo-madera.jpg'); "
		>
		</div>

		<!-- Main Content Wrapper -->
		<div
			class="relative z-10 max-w-md mx-auto min-h-screen bg-black/20 shadow-2xl flex flex-col"
		>
			<!-- Floating Language Switcher -->
			<div class="lang-switcher-float">
				<LanguageSwitcher currentLang={lang} />
			</div>

			<slot />
		</div>
		<style is:global>
			:root {
				--font-sans: "Inter", system-ui, -apple-system, sans-serif;
			}
			body {
				font-family: var(--font-sans);
			}

			/* Disable double-tap to zoom for better mobile app feel */
			html,
			body {
				touch-action: manipulation;
				-webkit-tap-highlight-color: transparent;
			}
		</style>
		<style>
			.lang-switcher-float {
				position: absolute;
				top: 12px;
				right: 12px;
				z-index: 50;
			}
		</style>
	</body>
</html>
