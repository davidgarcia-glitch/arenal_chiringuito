---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { t, type Lang } from "../i18n/translations";
import { ClientRouter } from "astro:transitions";
import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	lang?: Lang;
}

const { lang = "es" } = Astro.props;
const i = t(lang);
const pageTitle = Astro.props.title ? `${Astro.props.title} | Arenal El Chiringuito` : i.seoTitle;
const currentUrl = new URL(Astro.url.pathname, "https://www.arenalelchiringuito.es");

// Rutas limpias para hreflang dinámicos
const cleanPath = Astro.url.pathname.replace(/^\/(es|en|fr)(\/|$)/, "").replace(/^\/+/, "");
const esUrl = `https://www.arenalelchiringuito.es/es/${cleanPath}`;
const enUrl = `https://www.arenalelchiringuito.es/en/${cleanPath}`;
const frUrl = `https://www.arenalelchiringuito.es/fr/${cleanPath}`;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<title>{pageTitle}</title>
		<meta name="description" content={i.seoDescription} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="canonical" href={currentUrl} />
		
		<!-- Preload Critical Images for LCP -->
		<link rel="preload" as="image" href="/img/fondo-madera.webp" fetchpriority="high" />
		<link rel="preload" as="image" href="/img/logo.webp" fetchpriority="high" />
		<slot name="head" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={i.seoDescription} />
		<meta property="og:image" content="https://www.arenalelchiringuito.es/img/terraza-noche.jpg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={currentUrl} />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={i.seoDescription} />
		<meta property="twitter:image" content="https://www.arenalelchiringuito.es/img/terraza-noche.jpg" />

		<!-- Hreflang for International SEO -->
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="fr" href={frUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />

		<!-- Icons & Theme -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<meta name="theme-color" content="#1a1311" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />

		<!-- JSON-LD LocalBusiness -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Restaurant",
			"name": "Arenal El Chiringuito",
			"image": "https://www.arenalelchiringuito.es/img/terraza-noche.jpg",
			"description": i.seoDescription,
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "Arenal El Chiringuito",
				"addressLocality": "Blanca",
				"addressRegion": "Murcia",
				"postalCode": "30540",
				"addressCountry": "ES"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": 38.1813301,
				"longitude": -1.3790201
			},
			"url": "https://www.arenalelchiringuito.es",
			"servesCuisine": ["Tapas", "Hamburguesas", "Mediterránea"],
			"priceRange": "€"
		})} />

		<!-- Google Fonts: Inter (Optimized) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
		</noscript>
	</head>
	<body
		class="bg-[#1a1311] text-zinc-100 antialiased min-h-screen relative font-sans"
	>

		<!-- Wood texture background overlay -->
		<div
			transition:persist
			class="fixed top-0 left-0 w-full z-0 pointer-events-none opacity-50 bg-cover bg-center"
			style="background-image: url('/img/fondo-madera.webp'); height: 100vh; height: 100lvh;"
		>
		</div>

		<!-- Interactive Sparks/Particles Canvas -->
		<canvas
			id="sparks-canvas"
			transition:persist
			class="fixed inset-0 z-40 pointer-events-none opacity-70"
		></canvas>

		<!-- Main Content Wrapper -->
		<div
			class="relative z-10 max-w-md mx-auto min-h-screen bg-black/20 shadow-2xl flex flex-col"
		>
			<!-- Floating Language Switcher -->
			<div class="lang-switcher-float">
				<LanguageSwitcher currentLang={lang} />
			</div>

			<slot />
		</div>
		<style is:global>
			:root {
				--font-sans: "Inter", system-ui, -apple-system, sans-serif;
			}
			body {
				font-family: var(--font-sans);
			}

			/* Disable double-tap to zoom for better mobile app feel */
			html,
			body {
				touch-action: manipulation;
				-webkit-tap-highlight-color: transparent;
			}

			/* Cinematic Scroll Reveal Styles */
			.scroll-reveal {
				opacity: 0;
				transform: translateY(22px) scale(0.97);
				transition: 
					opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
					transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
				will-change: opacity, transform;
			}
			.scroll-reveal.active {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		</style>
		<style>
			.lang-switcher-float {
				position: absolute;
				top: 12px;
				right: 12px;
				z-index: 50;
			}
		</style>
		<script is:inline>
			function initSparks() {
				const canvas = document.getElementById('sparks-canvas');
				if (!canvas) return;

				const ctx = canvas.getContext('2d');
				if (!ctx) return;

				let width = (canvas.width = window.innerWidth);
				let height = (canvas.height = window.innerHeight);

				// Redimensionar
				function handleResize() {
					if (!canvas) return;
					width = canvas.width = window.innerWidth;
					height = canvas.height = window.innerHeight;
				}
				window.addEventListener('resize', handleResize);

				// Clase Partícula
				class Particle {
					constructor(x, y, isBurst = false) {
						this.x = x;
						this.y = y;
						this.size = Math.random() * 2.2 + 0.8; // 0.8px a 3px
						
						if (isBurst) {
							// Explosión radial sutil al tocar
							const angle = Math.random() * Math.PI * 2;
							const speed = Math.random() * 1.5 + 0.5;
							this.speedX = Math.cos(angle) * speed;
							this.speedY = Math.sin(angle) * speed - 0.4;
							this.decay = Math.random() * 0.02 + 0.015;
						} else {
							// Ascenso lento y flotante (ambiente)
							this.speedX = Math.random() * 0.4 - 0.2;
							this.speedY = -Math.random() * 0.6 - 0.3;
							this.decay = Math.random() * 0.008 + 0.004;
						}

						// Colores cálidos tipo brasa (rojo-naranja-dorado)
						const hue = Math.floor(Math.random() * 20) + 15; // 15 a 35
						this.color = `hsla(${hue}, 100%, 60%, `;
						this.life = 1.0;
					}

					update() {
						this.x += this.speedX;
						this.y += this.speedY;
						this.life -= this.decay;
						
						// Desvanecimiento del tamaño
						if (this.size > 0.2) this.size -= 0.015;
					}

					draw(context) {
						context.save();
						context.beginPath();
						context.arc(this.x, this.y, this.size, 0, Math.PI * 2);
						
						// Brillo luminoso
						context.shadowBlur = this.size * 2.5;
						context.shadowColor = `hsl(20, 100%, 50%)`;
						context.fillStyle = this.color + this.life + ')';
						
						context.fill();
						context.restore();
					}
				}

				let particles = [];
				let isDrawing = false;

				// Generador de partículas de ambiente
				function spawnAmbient() {
					if (particles.length < 15 && Math.random() < 0.05) {
						// Aparecen desde abajo de la pantalla
						particles.push(new Particle(Math.random() * width, height + 10));
					}
				}

				// Crear chispas al interactuar
				function createSparks(clientX, clientY, count = 2) {
					for (let i = 0; i < count; i++) {
						particles.push(new Particle(clientX, clientY, true));
					}
					startLoop();
				}

				// Eventos
				function handleMouseMove(e) {
					createSparks(e.clientX, e.clientY, 1);
				}

				function handleTouchMove(e) {
					if (e.touches && e.touches[0]) {
						createSparks(e.touches[0].clientX, e.touches[0].clientY, 1);
					}
				}

				window.addEventListener('mousemove', handleMouseMove);
				window.addEventListener('touchmove', handleTouchMove, { passive: true });
				
				window.addEventListener('mousedown', (e) => {
					createSparks(e.clientX, e.clientY, 8);
				});
				window.addEventListener('touchstart', (e) => {
					if (e.touches && e.touches[0]) {
						createSparks(e.touches[0].clientX, e.touches[0].clientY, 10);
					}
				}, { passive: true });

				// Bucle de animación optimizado
				function loop() {
					if (!ctx || !canvas) return;
					ctx.clearRect(0, 0, width, height);

					spawnAmbient();

					for (let i = particles.length - 1; i >= 0; i--) {
						const p = particles[i];
						p.update();
						
						if (p.life <= 0 || p.x < 0 || p.x > width || p.y < 0) {
							particles.splice(i, 1);
						} else {
							p.draw(ctx);
						}
					}

					if (particles.length > 0) {
						requestAnimationFrame(loop);
					} else {
						isDrawing = false;
					}
				}

				function startLoop() {
					if (!isDrawing) {
						isDrawing = true;
						loop();
					}
				}

				// Iniciar el bucle inicial
				startLoop();
			}


			// ─── IDEA 3: Contador de precio animado ──────────────────────
			function animatePrice(item) {
				const priceEl = item.querySelector('.price-display');
				if (!priceEl || priceEl.dataset.animated) return;
				priceEl.dataset.animated = '1';

				const raw = item.dataset.price || '';
				const match = raw.match(/(\d+(?:[,\.]\d+)?)/);
				if (!match) return;

				const targetVal = parseFloat(match[1].replace(',', '.'));
				const hasDecimal = match[1].includes(',');
				const prefix = raw.slice(0, raw.search(/\d/));
				const suffix = raw.slice(raw.search(/\d/) + match[1].length);

				const STEPS = 20;
				const DURATION = 480;
				let step = 0;

				const interval = setInterval(() => {
					step++;
					const progress = step / STEPS;
					const eased = 1 - Math.pow(1 - progress, 3);
					const current = targetVal * eased;
					priceEl.textContent = prefix + (
						hasDecimal
							? current.toFixed(2).replace('.', ',')
							: Math.round(current).toString()
					) + suffix;
					if (step >= STEPS) {
						priceEl.textContent = raw;
						clearInterval(interval);
					}
				}, DURATION / STEPS);
			}

			// ScrollReveal mejorado: activa precio al aparecer
			function initScrollReveal() {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
							observer.unobserve(entry.target);
							if (entry.target.classList.contains('product-item')) {
								setTimeout(() => animatePrice(entry.target), 150);
							}
						}
					});
				}, {
					threshold: 0.05,
					rootMargin: "0px 0px -30px 0px"
				});

				const elements = document.querySelectorAll(
					'.link-card, .info-card, .product-item, .terrace-card, .legal-card, main h1, main p:not(.info-detail):not(.schedule-day)'
				);

				let delay = 0;
				elements.forEach((el) => {
					if (el.classList.contains('scroll-reveal')) return;
					el.classList.add('scroll-reveal');
					const rect = el.getBoundingClientRect();
					if (rect.top < window.innerHeight) {
						el.style.transitionDelay = `${delay}ms`;
						delay += 60;
					}
					observer.observe(el);
				});
			}

			// Iniciar todo en carga y transiciones de Astro
			document.addEventListener('astro:page-load', () => {
				initSparks();
				initScrollReveal();
			});
		</script>
		<Analytics />
	</body>
</html>
